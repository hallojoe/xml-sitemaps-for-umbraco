{
  "XmlSitemaps": {
    "Enabled": true,
    "RewritesEnabled": true,
    "Mode": "Configuration",
    "IncludedContentTypeAliases": [],
    "ExcludedContentTypeAliases": [],
    "ExcludingUrlPropertyAlias": "umbracoNaviHide",
    "ExcludingUrlPropertyValue": "1",
    "UseDeliveryApiAccessPolicy": false,
    "IndexName": "ExternalIndex",
    "IncludedCultures": [
      "en",
      "da",
      "pl"
    ],
    "ExcludedCultures": [],
    "RenderAlternateLinksForSingleCultureSitemaps": true,
    "__Storage": {
      "RefreshStaleAfterSeconds": 3600,
      "BackgroundJob": {
        "IntervalSeconds": 3600,
        "RefreshJobDelayInSeconds": 300        
      }
    },
    "Indexes": {
      "xmlsitemapindex": {
        "PublicName": "xmlsitemapindex",
        "HostName": "https://localhost:44317",
        "Sitemaps": [
          "xmlsitemap-host-default",
          "custom-sitemap"
        ]
      },
      "xmlsitemapindex1": {
        "PublicName": "xmlsitemapindex",
        "HostName": "https://localhost:44318",
        "Sitemaps": [
          "xmlsitemap-host-1"
        ]
      },
      "xmlsitemapindex2": {
        "PublicName": "xmlsitemapindex",
        "HostName": "https://localhost:44319",
        "ExcludedContentTypes": ["newsPage"],
        "Sitemaps": [
          "xmlsitemap-host-2"
        ]
      }

    },
    "CustomSitemaps": {
      "custom-sitemap": {
        "PublicName": "xmlsitemap-custom",
        "ProviderAlias": "custom-sitemap-provider",
        "HostName": "https://localhost:44317",
        "Settings": {
          "Source": "Demo XML sitemap provider"
        }
      }
    },
    "Sitemaps": {
      "xmlsitemap-host-default": {
        "PublicName": "xmlsitemap",
        "Path": "/",
        "HostName": "https://website1.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "en",
          "pl",
          "da"
        ]
      },
      "xmlsitemap-host-default-subset-1": {
        "PublicName": "xmlsitemap-subset-1",
        "Path": "/tekst-side/teskst-under-side-1/",
        "HostName": "https://website1.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ],
         "ExcludedCultures": ["en", "pl"]
      },
      "xmlsitemap-host-default-subset-2": {
        "PublicName": "xmlsitemap-subset-2",
        "Path": "/tekst-side/teskst-under-side-2/",
        "HostName": "https://website1.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ],
        "ExcludedCultures": ["en" ,"pl"]
      },

      "xmlsitemap-website2": {
        "PublicName": "xmlsitemap",
        "Path": "/",
        "HostName": "https://website2.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ]
      },
      "xmlsitemap-website3": {
        "PublicName": "xmlsitemap",
        "Path": "/",
        "HostName": "https://website3.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ]
      }
    }
  }
}
