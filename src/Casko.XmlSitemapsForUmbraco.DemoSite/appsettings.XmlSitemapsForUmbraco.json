{
  "XmlSitemaps": {
    "Enabled": true,
    "RewritesEnabled": false,
    "Mode": "Configuration",
    "IncludedContentTypeAliases": [],
    "ExcludedContentTypeAliases": [],
    "ExcludingUrlPropertyAlias": "umbracoNaviHide",
    "ExcludingUrlPropertyValue": "1",
    "UseDeliveryApiAccessPolicy": false,
    "IndexName": "DeliveryApiContentIndex",
    "IncludedCultures": [
      "en",
      "da",
      "pl"
    ],
    "ExcludedCultures": [],
    "RenderAlternateLinksForSingleCultureSitemaps": false,
    "__Storage": {
      "VersionCleanupAfterSeconds": 10,
      "BackgroundJob": {
        "Enabled": true,
        "IntervalSeconds": 90,
        "RefreshJobDelayInSeconds": 30        
      }
    },
    "Indexes": {
      "xmlsitemapindex": {
        "PublicName": "xmlsitemapindex",
        "HostName": "https://website1.dev.localhost",
        "Sitemaps": [
          "xmlsitemap-host-default",
          "xmlsitemap-host-subsite",
          "xmlsitemap-host-default-area-1-da",
          "custom-sitemap"
        ]
      }
    },
    "CustomSitemaps": {
      "custom-sitemap": {
        "PublicName": "xmlsitemap-custom",
        "ProviderAlias": "custom-sitemap-provider",
        "HostName": "https://website1.dev.localhost",
        "Settings": {
          "Source": "Demo XML sitemap provider"
        }
      }
    },
    "Sitemaps": {
      "xmlsitemap-host-default": {
        "PublicName": "xmlsitemap",
        "Path": "/",
        "HostName": "https://website1.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "en",
          "pl",
          "da"
        ]
      },
      "xmlsitemap-host-subsite": {
        "PublicName": "xmlsitemap-subsite",
        "Path": "/",
        "HostName": "https://website1.dev.localhost/subsite",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ]
      },
      "xmlsitemap-host-default-area-1-da": {
        "PublicName": "xmlsitemap-area-1-da",
        "Path": "/omraade-1/sektion-1/",
        "HostName": "https://website1.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ],
         "ExcludedCultures": ["en", "pl"]
      },
      "xmlsitemap-host-default-area-2-en": {
        "PublicName": "xmlsitemap-area-1-en",
        "Path": "/area-1/",
        "HostName": "https://website1.dev.localhost/en/",
        "Culture": "en",
        "IncludedCultures": [
          "en"
        ],
        "ExcludedCultures": ["da", "pl"]
      },
      "xmlsitemap-website2": {
        "PublicName": "xmlsitemap",
        "Path": "/",
        "HostName": "https://website2.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ],
        "ExcludedCultures": ["en", "pl"]
      },
      "xmlsitemap-website3": {
        "PublicName": "xmlsitemap",
        "Path": "/",
        "HostName": "https://website3.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ]
      }
    }
  }
}
