{
  "XmlSitemaps": {
    "Enabled": true,
    "RewritesEnabled": true,
    "Mode": "Configuration",
    "ExcludingUrlPropertyAlias": "umbracoNaviHide",
    "ExcludingUrlPropertyValue": "1",
    "UseDeliveryApiAccessPolicy": false,
    "RenderAlternateLinksForSingleCultureSitemaps": true,
    "__Storage": {
      "RefreshStaleAfterSeconds": 600,
      "BackgroundJob": {
        "Enabled": true,
        "IntervalSeconds": 300,
        "RefreshJobDelayInSeconds": 120        
      }
    }
  }
}
