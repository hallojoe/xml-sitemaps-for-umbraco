{
  "XmlSitemaps": {
    "Enabled": true,
    "RewritesEnabled": true,
    "Mode": "Configuration",
    "IncludedContentTypeAliases": [],
    "ExcludedContentTypeAliases": [],
    "ExcludingUrlPropertyAlias": "umbracoNaviHide",
    "ExcludingUrlPropertyValue": "1",
    "UseDeliveryApiAccessPolicy": false,
    "IndexName": "ExternalIndex",
    "IncludedCultures": [
      "en",
      "da",
      "pl"
    ],
    "ExcludedCultures": [],
    "RenderAlternateLinksForSingleCultureSitemaps": true,
    "Storage": {
      "VersionCleanupAfterSeconds": 600,
      "BackgroundJob": {
        "Enabled": true,
        "IntervalSeconds": 300,
        "RefreshJobDelayInSeconds": 120        
      }
    },
    "Indexes": {
      "xmlsitemapindex": {
        "PublicName": "xmlsitemapindex",
        "HostName": "https://website1.dev.localhost",
        "Sitemaps": [
          "xmlsitemap-site1",
          "xmlsitemap-site2",
          "xmlsitemap-site2-da",
          "xmlsitemap-site2-en"
        ]
      }
    },
    "Sitemaps": {
      "xmlsitemap-site1": {
        "PublicName": "xmlsitemap-site1",
        "Path": "/",
        "HostName": "https://website1.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "en",
          "da"
        ]
      },
      "xmlsitemap-site2-da": {
        "PublicName": "xmlsitemap-site2-da",
        "Path": "/site-2/",
        "HostName": "https://website1.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ],
         "ExcludedCultures": ["en"]
      },
      "xmlsitemap-site2-en": {
        "PublicName": "xmlsitemap-site2-en",
        "Path": "/en/site-2/",
        "HostName": "",
        "Culture": "en",
        "IncludedCultures": [
          "en"
        ],
        "ExcludedCultures": ["da", "pl"]
      },
      "xmlsitemap-site2": {
        "PublicName": "xmlsitemap-site2",
        "Path": "/site-2/",
        "HostName": "https://website1.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da", "en"
        ],
        "ExcludedCultures": []
      },
      "xmlsitemap-site3": {
        "PublicName": "xmlsitemap",
        "Path": "/",
        "HostName": "https://website3.dev.localhost",
        "Culture": "da",
        "IncludedCultures": [
          "da"
        ]
      }
    }
  }
}
