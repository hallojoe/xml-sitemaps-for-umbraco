{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "single-site": {
        "ClusterId": "single-site",
        "Match": {
          "Hosts": [
            "single-site.dev.localhost:4443"
          ],
          "Path": "{**catch-all}"
        }
      },
      "mixed-variant-site": {
        "ClusterId": "mixed-site",
        "Match": {
          "Hosts": [
            "mixed-site.dev.localhost:4443"
          ],
          "Path": "{**catch-all}"
        }
      },
      "language-variant-site": {
        "ClusterId": "language-variant-site",
        "Match": {
          "Hosts": [
            "language-variant-site.dev.localhost:4443"
          ],
          "Path": "{**catch-all}"
        }
      },
      "many-1-site": {
        "ClusterId": "many-1-site",
        "Match": {
          "Hosts": [
            "many-1-site.dev.localhost:4443"
          ],
          "Path": "{**catch-all}"
        }
      },
      "many-2-site": {
        "ClusterId": "many-2-site",
        "Match": {
          "Hosts": [
            "many-2-site.dev.localhost:4443"
          ],
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "single-site": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44317/"
          }
        }
      },
      "mixed-site": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44327/"
          }
        }
      },
      "language-variant-site": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44337/"
          }
        }
      },
      "many-1-site": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44347/"
          }
        }
      },
      "many-2-site": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44347/"
          }
        }
      }
    }
  }
}
