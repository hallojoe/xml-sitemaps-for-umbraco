{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },

  "XmlSiteMaps": {
    "Enabled": true,
    "RewritesEnabled": true,
    "IncludedContentTypeAliases": [],
    "ExcludedContentTypeAliases": [],
    "IncludedCultures": ["en", "da"],
    "ExcludedCultures": ["pl"],
    "RenderAlternateLinksForSingleCultureSitemaps": true,
    "Storage": {
      "RefreshStaleAfterSeconds": 3600,
      "BackgroundJob": {
        "Enabled": true,
        "IntervalSeconds": 3600
      }
    },
    "Indexes": {
      "xmlsitemap": {
        "HostName": "https://localhost:44341",
        "Sitemaps": [
          "xmlsitemap-en",
          "xmlsitemap-da"
        ]
      }
    },
    "Sitemaps": {
      "xmlsitemap-host-dk-en": {
        "Path": "/",
        "HostName": "https://localhost:44341",
        "Culture": "en",
        "IncludedCultures": ["en"],
        "ExcludedCultures": ["pl", "da"],
        "IncludedDocumentTypeAliases": [],
        "ExcludedDocumentTypeAliases": []
      },
      "xmlsitemap-host-dk-da": {
        "Path": "/",
        "Culture": "da",
        "IncludedCultures": ["da"],
        "ExcludedCultures": ["pl", "en"],
        "IncludedDocumentTypeAliases": [],
        "ExcludedDocumentTypeAliases": []
      },
      "xmlsitemap-en": {
        "Path": "/",
        "HostName": null,
        "Culture": "en",
        "IncludedCultures": ["en"],
        "ExcludedCultures": ["pl", "da"],
        "IncludedDocumentTypeAliases": [],
        "ExcludedDocumentTypeAliases": []
      },
      "xmlsitemap-da": {
        "Path": "/",
        "HostName": null,
        "Culture": "da",
        "IncludedCultures": ["da"],
        "ExcludedCultures": ["pl", "en"],
        "IncludedDocumentTypeAliases": [],
        "ExcludedDocumentTypeAliases": []
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "e2978b44-ac29-4531-a46f-62a7480c5304",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "1234567890"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "InstallDefaultData": {
        "Languages": {
          "InstallData": "Values",
          "Values": [
            "en",
            "da",
            "pl"
          ]
        }
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "RichTextOutputAsJson": true
      },
      "Imaging": {
        "HMACSecretKey": "Zv23ucZGGXUO33ayDN95ytvq\u002B39ev5P7TsJkmes9cxInZQW1HuEoj53GUQsIS7Ii5RCnyqlM3aheUlmYQOg0qg=="
      }
    }
  }
}
