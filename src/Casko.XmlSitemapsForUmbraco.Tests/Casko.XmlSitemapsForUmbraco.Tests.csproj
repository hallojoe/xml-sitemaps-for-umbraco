<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <CoverletExclude>[Casko.XmlSitemapsForUmbraco.TestSite]*</CoverletExclude>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit3TestAdapter" />
        <PackageReference Include="Umbraco.Cms.Tests.Integration" />
        <PackageReference Include="coverlet.msbuild">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Casko.XmlSitemapsForUmbraco.Delivery\Casko.XmlSitemapsForUmbraco.Delivery.csproj" />
        <ProjectReference Include="..\Casko.XmlSitemapsForUmbraco.Storage\Casko.XmlSitemapsForUmbraco.Storage.csproj" />
        <ProjectReference Include="..\Casko.XmlSitemapsForUmbraco.TestSite\Casko.XmlSitemapsForUmbraco.TestSite.csproj" />
        <ProjectReference Include="..\Casko.XmlSitemapsForUmbraco.Package\Casko.XmlSitemapsForUmbraco.Package.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="appsettings.Tests.Local.json" CopyToOutputDirectory="Always"/>
        <None Include="appsettings.Tests.json" CopyToOutputDirectory="Always"/>
    </ItemGroup>

    <Target Name="CopyUmbracoIntegrationDeps" AfterTargets="Build">
        <Copy
                SourceFiles="$(OutputPath)$(AssemblyName).deps.json"
                DestinationFiles="$(OutputPath)Umbraco.Tests.Integration.deps.json"
                SkipUnchangedFiles="true"
                Condition="Exists('$(OutputPath)$(AssemblyName).deps.json')"/>
    </Target>

    <Target Name="CreateTestTempDirectories" BeforeTargets="Build">
        <MakeDir Directories="$(ProjectDir)TEMP"/>
        <MakeDir Directories="$(ProjectDir)TEMP\media"/>
        <MakeDir Directories="$(ProjectDir)TEMP\cache"/>
        <MakeDir Directories="$(ProjectDir)TEMP\logs"/>
        <MakeDir Directories="$(ProjectDir)TEMP\databases"/>
    </Target>

</Project>


